[Unit]
Description=Crude Code activity digest email
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/crudecode
ExecStart=/home/ubuntu/crudecode/.venv/bin/python -m ingest activity_digest
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/ubuntu/crudecode/.env
