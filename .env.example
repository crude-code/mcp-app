# Copy to .env and fill in. Loaded by utils/env.py at import time.

# --- Required ---
# Postgres database holding the oil & gas tables the tools query.
# Schema must match utils/schemas.py and prompts/outer/shared_schema.md.
# (The legacy name EI_DB_URL is still accepted.)
CC_DB_URL=postgresql://user:password@host:5432/dbname

# Supabase Postgres connection used for user identity / org membership and
# the platform.* tables (runs, rooms, extractions, team messages).
SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Storage (production) ---
# Supabase Storage holds dataroom zips and large extraction payloads
# (server/blob_store.py). Unset → extractions rest inline in their rows and
# dataroom_open's upload lane is unavailable; fine for local dev and tests.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Export links ---
# Any long random string. Signs run-scoped export links so they survive
# restarts, which is what lets a deal sheet carry a download row. Unset → the
# export lane falls back to short-lived in-memory tickets and the sheet renders
# no download row. Rotating it invalidates every outstanding signed link.
CC_EXPORT_SECRET=

# --- Optional ---
# Port the FastMCP server binds (default 9000).
MCP_PORT=9000

# Public base URL for upload/export links when the request's Host header is
# not the one users should follow (prod routes these through the apex; see
# deploy/nginx/crudecode-site.conf). Defaults to the request host.
CC_UPLOAD_BASE_URL=

# Base URL where the deploy scripts publish the deal-sheet template and skill
# files (default https://crudecode.dev/templates). Override for local testing.
CC_TEMPLATE_BASE_URL=

# Chat mode: this deployment serves a host that cannot render claude.ai
# artifacts or the MCP-app map. Tool responses drop the template and the map
# token, and every prompt surface gains prompts/outer/chat_mode.md. The dev
# server sets it via deploy/dev.env; prod never does.
CC_CHAT_MODE=

# AWS SES credentials for team notifications (utils/ses.py). Unset → boto3's
# default credential chain (instance role, ~/.aws) is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Error reporting (optional).
SENTRY_DSN_PYTHON=
SENTRY_ENV=development
