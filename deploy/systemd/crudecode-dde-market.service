[Unit]
Description=Crude Code DDE market ingest (benchmark_prices + futures)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/crudecode
ExecStart=/home/ubuntu/crudecode/.venv/bin/python -m ingest dde_market
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/ubuntu/crudecode/.env
