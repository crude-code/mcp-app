[Unit]
Description=Crude Code DJ development-cohort feature engineering
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/crudecode
ExecStart=/home/ubuntu/crudecode/.venv/bin/python -m ingest dev_cohorts_dj
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/ubuntu/crudecode/.env
TimeoutStartSec=2h
